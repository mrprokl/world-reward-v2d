  "inference_contract": {
    "allowed_inputs": [
      "one original RGB video from front_stereo_camera_left",
      "native object.prompt from eligible sequence metadata",
      "native action description from eligible sequence metadata",
      "original frame indices 0,14,29"
    ],
    "forbidden_inputs": [
      "reference masks or mask-derived bboxes",
      "reference poses or meshes",
      "source camera intrinsics/extrinsics",
      "depth",
      "other camera images",
      "ground plane",
      "symmetry annotations",
      "quality flags as prediction inputs"
    ],
    "no_manual_prompts_or_per_sequence_tuning": true,
    "no_first30_full_video_tracking": true,
    "camera_or_native_text_missing": "fail; no manual substitution or invented prompt",
    "storage_and_compute": "Azure only; local repository contains this tiny protocol and audit, no archives/media/reference arrays"
  },
  "evaluator_contract": {
    "references": "reconstructed multiview pseudo-ground-truth, not verified motion-capture truth",
    "isolation": "references/masks/calibration mounted only into evaluator after predictions are frozen; never inference",
    "initial_localization_metrics": [
      "box IoU to segmentation-derived visible-reference bbox",
      "visible-reference mask coverage by predicted bbox",
      "person/object mask IoU",
      "explicit missing response/abstention rate",
      "latency and cost"
    ],
    "visibility": "empty reference masks scored separately; do not manufacture boxes or treat invisible objects as detection success",
    "quality_reporting": [
      "all selected frames",
      "same frozen frames excluding declared QC-flagged intervals; publish count and flag reasons"
    ],
    "qc_caveat": "Human QC and automated Chamfer/containment flags can reflect mask/depth noise, not certain ground-truth error",
    "reserved_split": "four provisional families stay unopened; official group assignment and split disjointness must be verified before any held-out evaluation",
    "claim": "external pseudo-GT insight only; neither challenge score nor verified victory over CARI4D"
  },
