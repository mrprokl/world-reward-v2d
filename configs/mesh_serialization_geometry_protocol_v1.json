{
  "schema": "world_reward.mesh_serialization_geometry_protocol.v1",
  "phase1_pins_required_before_run": true,
  "paired_backends": ["original_volume", "serialization_volume"],
  "fixtures": [
    {"name": "fresh_thin_ellipsoid_cavity", "outer_icosphere_subdivisions": 4, "inner_icosphere_subdivisions": 3, "axes": [1.0, 0.75, 0.55], "inner_axis_multiplier": 0.96, "inner_faces_reversed": true, "vertices": 3204, "faces": 6400},
    {"name": "fresh_corrugated_capsule", "radius": 0.35, "cylinder_half_length": 0.65, "azimuths": 96, "cap_rings_each": 15, "cylinder_rings": 33, "cap_latitude_step": "pi/32", "corrugation": "0.035*sin(24*pi*k/32)*(1-(z/0.65)**2)**2", "unique_poles": 2, "vertices": 6050, "faces": 12096}
  ],
  "fixed_source_scale": "2**-16",
  "source_initial_serialization_safe_required": true,
  "source_embedding_checked": true,
  "reuse_original_geometry_math_unchanged": true,
  "original_failure_is_recorded_comparison_not_new_backend_failure": true,
  "new_backend_any_failed_geometry_gate": "stop_preserve_partial_scalar_evidence",
  "native_calls_maximum": 4,
  "native_seconds_per_call": 900,
  "compile_seconds": 600,
  "inclusive_total_seconds": 5400,
  "receipt_publication_grace_seconds": 10,
  "publication_grace_scope": "write_fsync_tiny_failed_or_success_receipt_only_no_computation_or_geometry_cleanup",
  "cpu_count": 4,
  "memory_gib": 16,
  "network": "none",
  "read_only_root": true,
  "cap_drop": "ALL",
  "no_new_privileges": true,
  "gpu_used": false,
  "dependency_installation": false,
  "geometry_stages": ["source", "candidate", "float32_export", "unmodified_official_pack", "once_baked_metric_geometry"],
  "float32_geometry_math": "exact_float64_promotion_no_coordinate_changes",
  "maximum_packed_faces_and_vertices": 4096,
  "sampled_bidirectional_chamfer_diagonal_limit": 0.01,
  "each_original_shell_and_net_volume_relative_limit": 0.05,
  "metric_bake_scale": 0.375,
  "source_shell_coverage_and_birth_provenance_required": true,
  "zero_intersecting_faces_required_each_stage": true,
  "cavity_containment_required_each_stage": true,
  "second_official_simplification_allowed": false,
  "new_backend_real_collapses_required_each_fixture": true,
  "serialization_veto_required_for_mechanism_qualification": true,
  "zero_veto_after_all_geometry_pass": "inconclusive_no_fixture_reroll",
  "no_geometry_component_loss_or_scale_fit": true,
  "claims": {"procedural_geometry_qualification_only": true, "real_HOI_accuracy_validated": false, "challenge_performance_verified": false, "adoption": false},
  "cleanup": "owned_scratch_and_exact_owned_container_only_keep_tiny_results",
  "failure_policy": "no_retry_refixture_threshold_change_clip_retune_or_historical_relabel"
}
